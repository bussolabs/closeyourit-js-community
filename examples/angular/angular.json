{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "proof": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist/proof",
            "sourceMap": true,
            "optimization": true,
            "polyfills": []
          }
        }
      }
    }
  }
}
